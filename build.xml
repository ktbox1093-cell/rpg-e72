
<project name="RPGE72" default="package" basedir=".">
    <property name="wtk.home" value="C:/WTK2.5.2"/> <!-- Ruta por defecto del Wireless Toolkit en Windows -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.dir}" target="1.3" source="1.3" bootclasspath="${wtk.home}/lib/cldc_1.1.jar;${wtk.home}/lib/midp_2.0.jar"/>
    </target>

    <target name="package" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/RPGE72.jar" manifest="MANIFEST.MF">
            <fileset dir="${build.dir}"/>
        </jar>
        <echo message="¡Juego empaquetado con éxito en dist/RPGE72.jar! Listo para pasarlo al Nokia E72."/>
    </target>
</project>
